# ⚡ Code Documentation Navigator - Environment Configuration

# Gemini API Key (OPTIONAL - app works without it!)
# Get your FREE key from: https://makersuite.google.com/app/apikey
# See GET_API_KEY.md for detailed instructions

GEMINI_API_KEY=your_api_key_here

# For Windows PowerShell:
#   $env:GEMINI_API_KEY = "your_api_key_here"
#   streamlit run app.py

# For Mac/Linux:
#   export GEMINI_API_KEY="your_api_key_here"
#   streamlit run app.py

# For Streamlit Cloud:
# 1. Go to your app settings
# 2. Click "Secrets" in the left sidebar
# 3. Add your API key in TOML format:
#    GEMINI_API_KEY = "your_api_key_here"
